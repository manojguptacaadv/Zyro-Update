rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow users to upload and read their own photos and documents in users/{userId}/...
    match /users/{userId}/{allPaths=**} {
      allow read: if true; // Allows viewing uploaded profile & document photos
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
